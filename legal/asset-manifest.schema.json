{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worms_Port asset manifest",
  "type": "object",
  "required": ["policy", "checked_date", "assets"],
  "properties": {
    "policy": { "type": "string" },
    "checked_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "origin_repo",
          "original_source_url",
          "author",
          "license",
          "commercial_use_allowed",
          "redistribution_allowed",
          "modification_allowed",
          "attribution_required",
          "share_alike",
          "no_technical_restrictions",
          "evidence_url",
          "checked_date",
          "decision",
          "notes"
        ],
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string", "pattern": "^assets/" },
          "origin_repo": { "type": "string" },
          "original_source_url": { "type": "string" },
          "author": { "type": "string" },
          "license": { "type": "string" },
          "commercial_use_allowed": { "type": "boolean" },
          "redistribution_allowed": { "type": "boolean" },
          "modification_allowed": { "type": "boolean" },
          "attribution_required": { "type": "boolean" },
          "share_alike": { "type": "boolean" },
          "no_technical_restrictions": { "type": "boolean" },
          "evidence_url": { "type": "string" },
          "checked_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "decision": { "type": "string", "enum": ["approved"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
