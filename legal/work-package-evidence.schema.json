{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TasirWimp/Worms_Port/legal/work-package-evidence.schema.json",
  "title": "NIMble Knots work-package evidence",
  "type": "object",
  "required": [
    "id",
    "status",
    "starting_commit",
    "branch",
    "initial_worktree",
    "starting_lock_sha256",
    "owning_roles",
    "scope",
    "non_goals",
    "planned_checks",
    "deterministic_seeds",
    "sorcerers_reference_used",
    "clean_room_records"
  ],
  "properties": {
    "execution_mode": { "enum": ["single_owner"], "description": "Explicit post-retirement direct ownership; historical support records remain evidence, not active collaboration requirements." },
    "id": { "type": "string", "pattern": "^WP-[0-9]{3}(?:[A-Z]|[A-Z][0-9][A-Z])?$" },
    "status": { "enum": ["in_progress", "complete", "blocked", "superseded"] },
    "superseded_by": { "type": "string", "minLength": 1 },
    "supersession_reason": { "type": "string", "minLength": 1 },
    "starting_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "branch": { "type": "string", "minLength": 1 },
    "initial_worktree": { "enum": ["clean", "dirty-preserved"] },
    "starting_lock_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "owning_roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "non_goals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "planned_checks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "deterministic_seeds": { "type": "array", "items": { "type": "string" } },
    "sorcerers_reference_used": { "type": "boolean" },
    "clean_room_records": { "type": "array", "items": { "type": "string" } },
    "check_results": { "type": "array" },
    "reviews": { "type": "array" },
    "support_episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "participants", "source_binding", "exchanges"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "reduced", "blocked", "reopened"] },
          "participants": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "requested", "runtime"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "requested": {
                  "type": "object",
                  "required": ["model", "effort"],
                  "properties": {
                    "model": { "type": "string", "minLength": 1 },
                    "effort": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                },
                "runtime": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "enum": ["unknown", "reported"] },
                    "model": { "type": "string", "minLength": 1 },
                    "effort": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "source_binding": {
            "type": "object",
            "required": ["commit", "paths", "relationship"],
            "properties": {
              "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
              "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "relationship": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "exchanges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "from", "to", "source", "probe", "remaining_uncertainty", "consequential"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "from": { "type": "string", "minLength": 1 },
                "to": { "type": "string", "minLength": 1 },
                "source": { "$ref": "#/$defs/boundSource" },
                "probe": { "type": "string", "minLength": 1 },
                "remaining_uncertainty": { "type": "string", "minLength": 1 },
                "consequential": { "type": "boolean" },
                "recipient_disposition": {
                  "type": "object",
                  "required": ["status", "detail"],
                  "properties": {
                    "status": { "enum": ["received", "pending"] },
                    "detail": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "closure": {
            "type": "object",
            "required": ["source_currentness", "distinction", "evidence", "support_assumptions", "reopen_cue"],
            "properties": {
              "source_currentness": {
                "type": "object",
                "required": ["commit", "paths", "manual_candidate_review"],
                "properties": {
                  "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
                  "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                  "manual_candidate_review": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              "distinction": { "type": "string", "minLength": 1 },
              "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "support_assumptions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "reopen_cue": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "skipped_checks": { "type": "array" },
    "residual_risks": { "type": "array" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "superseded" } },
        "required": ["status"]
      },
      "then": { "required": ["superseded_by", "supersession_reason"] }
    }
  ],
  "$defs": {
    "boundSource": {
      "type": "object",
      "required": ["commit", "paths"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
