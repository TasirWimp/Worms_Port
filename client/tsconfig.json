{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "strict": false,
        "target": "ES2022",
        "types": ["vite/client"]
    },
    "include": ["src/**/*.ts", "../shared/**/*.d.ts"]
}
