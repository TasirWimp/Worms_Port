{
  "name": "nimble-knots",
  "version": "0.0.0",
  "description": "NIMble Knots: Cotton Clash, an MIT-licensed fantasy artillery game with strict third-party asset traceability.",
  "scripts": {
    "build-server": "node scripts/clean-dir.js server/build && esbuild server/src/server.ts --bundle --platform=node --target=node20 --format=cjs --external:@nimiq/core --outfile=server/build/server.js",
    "build-client": "vite build --config vite.client.config.ts && node scripts/copy-approved-assets.js",
    "build": "npm run check:compliance && npm run check:types && npm run build-server && npm run build-client",
    "check:asset-manifest": "node scripts/check-asset-manifest.js",
    "check:import-boundary": "node scripts/check-import-boundary.js",
    "check:package-licenses": "node scripts/check-package-licenses.js",
    "check:work-packages": "node scripts/check-work-package-evidence.js",
    "check:clean-room": "node scripts/check-clean-room-records.js",
    "check:identity-bundles": "node scripts/check-identity-bundles.js",
    "check:compliance": "npm run check:asset-manifest && npm run check:import-boundary && npm run check:package-licenses && npm run check:work-packages && npm run check:clean-room",
    "check:types": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test:tooling": "node --test tests/tooling/*.test.js",
    "test:protocol": "node --import tsx --test tests/protocol/*.test.ts",
    "test:simulation": "node --import tsx --test tests/simulation/*.test.ts",
    "test:loomkeeper": "node --import tsx --test tests/loomkeeper/*.test.ts",
    "test:relics": "node --import tsx --test tests/relics/*.test.ts",
    "test:combat": "node --import tsx --test tests/combat/*.test.ts",
    "test:practice": "node --import tsx --test tests/practice/*.test.ts",
    "test:identity": "node --import tsx --test tests/identity/*.test.ts",
    "test:reward": "node --import tsx --test tests/reward/*.test.ts",
    "smoke:built": "node scripts/smoke-built-server.js",
    "smoke": "npm run build && npm run smoke:built",
    "test:browser:smoke": "node scripts/run-playwright.js tests/browser/smoke.spec.ts",
    "test:browser:combat": "node scripts/run-playwright.js tests/browser/combat.spec.ts",
    "test:browser:practice": "node scripts/run-playwright.js tests/browser/practice.spec.ts",
    "test:browser:identity": "node scripts/run-playwright.js tests/browser/identity.spec.ts",
    "test:browser:reward": "node scripts/run-playwright.js tests/browser/reward.spec.ts",
    "test:browser": "node scripts/run-playwright.js",
    "verify:fast": "npm run check:compliance && npm run check:types && npm run test:tooling && npm run test:protocol && npm run test:simulation && npm run test:loomkeeper && npm run test:relics && npm run test:combat && npm run test:practice && npm run test:identity && npm run test:reward",
    "verify:runtime": "npm run build && npm run smoke:built && npm run test:browser:smoke",
    "verify:full": "npm run verify:fast && npm run verify:runtime && npm audit",
    "start": "node server/build/server.js",
    "dev-client": "vite --config vite.client.config.ts --host 0.0.0.0",
    "dev-server": "tsx watch server/src/server.ts"
  },
  "author": "TasirWimp",
  "license": "MIT",
  "contributors": [
    "P.U. Turtle"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TasirWimp/Worms_Port.git"
  },
  "overrides": {
    "postcss": "8.5.25"
  },
  "dependencies": {
    "@nimiq/core": "2.7.1",
    "@nimiq/mini-app-sdk": "0.1.0",
    "express": "^5.1.0",
    "pg": "8.22.0",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "toastify-js": "^1.12.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.10",
    "@types/pg": "8.20.0",
    "esbuild": "^0.25.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.2"
  }
}
