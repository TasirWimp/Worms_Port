{
  "name": "worms-port",
  "version": "0.0.0",
  "description": "MIT Phaser base with strict third-party asset traceability and Sorcerers quarantine workflow.",
  "scripts": {
    "build-server": "node scripts/clean-dir.js server/build && esbuild server/src/server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=server/build/server.js",
    "build-client": "vite build --config vite.client.config.ts",
    "build": "npm run check:compliance && npm run check:types && npm run build-server && npm run build-client",
    "check:asset-manifest": "node scripts/check-asset-manifest.js",
    "check:import-boundary": "node scripts/check-import-boundary.js",
    "check:package-licenses": "node scripts/check-package-licenses.js",
    "check:compliance": "npm run check:asset-manifest && npm run check:import-boundary && npm run check:package-licenses",
    "check:types": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "start": "node server/build/server.js",
    "dev-client": "vite --config vite.client.config.ts --host 0.0.0.0",
    "dev-server": "tsx watch server/src/server.ts"
  },
  "author": "TasirWimp",
  "license": "MIT",
  "contributors": [
    "P.U. Turtle"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TasirWimp/Worms_Port.git"
  },
  "dependencies": {
    "express": "^5.1.0",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "toastify-js": "^1.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.10",
    "esbuild": "^0.25.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.2"
  }
}
