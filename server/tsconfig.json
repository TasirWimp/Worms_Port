{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "baseUrl": "./src",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "module": "CommonJS",
        "moduleResolution": "Node",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": false,
        "target": "ES2022",
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "data/**/*.json", "../shared/**/*.d.ts"]
}
